<!doctype html>
<html lang="nb">
<head><%- include('partials/head') %></head>
<body>
<%- include('partials/header') %>

<main id="hovudinnhald">
  <section class="seksjon">
    <div class="wrap">
      <div class="seksjon__topp">
        <img class="ornament" src="/img/ornament.png" alt="" width="495" height="140">
        <span class="stikk">Kontakt</span>
        <h1><%= c.kontakt.tittel %></h1>
        <p><%= c.kontakt.ingress %></p>
      </div>

      <div class="kontakt-rutenett">
        <div id="skjema">
          <% if (sendt) { %>
            <div class="melding-boks melding-boks--ok" role="status">
              <strong>Meldingen er sendt.</strong> <%= c.kontakt.takketekst %>
            </div>
          <% } %>
          <%
            var feila = feilkode ? feilkode.split('-') : [];
            var harFeil = function (n) { return feila.indexOf(n) !== -1; };
          %>
          <% if (feilkode === 'for-mange') { %>
            <div class="melding-boks melding-boks--feil" role="alert">
              <strong>Du har sendt flere meldinger nettopp.</strong>
              Vent litt før du sender en til – eller ring oss direkte på
              <a href="<%= telefonLenke(c.bedrift.telefon) %>"><%= c.bedrift.telefon %></a>.
              Det du skrev står fortsatt i skjemaet.
            </div>
          <% } else if (feilkode === 'teknisk') { %>
            <div class="melding-boks melding-boks--feil" role="alert">
              <strong>Noe gikk galt hos oss.</strong> Meldingen ble ikke sendt.
              Prøv igjen om litt, eller ring oss på
              <a href="<%= telefonLenke(c.bedrift.telefon) %>"><%= c.bedrift.telefon %></a>.
              Det du skrev står fortsatt i skjemaet.
            </div>
          <% } else if (feil) { %>
            <div class="melding-boks melding-boks--feil" role="alert">
              <strong>Vi mangler noe før vi kan sende:</strong>
              <ul class="feilliste">
                <% if (harFeil('navn')) { %><li><a href="#navn">Fyll inn navnet ditt</a></li><% } %>
                <% if (harFeil('melding')) { %><li><a href="#melding">Skriv noen ord om hva det gjelder</a></li><% } %>
                <% if (harFeil('kontakt')) { %><li><a href="#epost">Fyll inn e-post eller telefon, så vi får svart deg</a></li><% } %>
                <% if (harFeil('epost')) { %><li><a href="#epost">E-postadressen ser ikke riktig ut – sjekk at den inneholder @ og et punktum</a></li><% } %>
                <% if (harFeil('telefon')) { %><li><a href="#telefon">Telefonnummeret ser ikke riktig ut – bruk bare tall</a></li><% } %>
              </ul>
              <span class="hint">Resten av det du skrev står fortsatt i skjemaet.</span>
            </div>
          <% } %>

          <form class="skjema" method="post" action="/kontakt">
            <div class="felt">
              <label for="navn">Navn <span class="hint">(påkrevd)</span></label>
              <input type="text" id="navn" name="navn" autocomplete="name" required maxlength="120"
                     value="<%= skjema.navn %>"
                     <% if (harFeil('navn')) { %>aria-invalid="true" autofocus<% } %>>
            </div>

            <div class="felt">
              <label for="epost">E-post</label>
              <input type="email" id="epost" name="epost" autocomplete="email" maxlength="160"
                     value="<%= skjema.epost %>"
                     <% if (harFeil('epost') || harFeil('kontakt')) { %>aria-invalid="true"<% } %>>
            </div>

            <div class="felt">
              <label for="telefon">Telefon</label>
              <input type="tel" id="telefon" name="telefon" autocomplete="tel" maxlength="40"
                     value="<%= skjema.telefon %>"
                     <% if (harFeil('telefon') || harFeil('kontakt')) { %>aria-invalid="true"<% } %>>
              <span class="hint">Fyll inn e-post eller telefon, så vi får svart deg.</span>
            </div>

            <div class="felt">
              <label for="tjeneste">Hva gjelder det?</label>
              <select id="tjeneste" name="tjeneste">
                <option value="">Velg gjerne en tjeneste</option>
                <% (Array.isArray(c.tjenester) ? c.tjenester : []).forEach(function (t) { %>
                  <option value="<%= t.navn %>"<% if (valdTeneste === t.navn) { %> selected<% } %>><%= t.navn %></option>
                <% }); %>
                <option value="Annet"<% if (valdTeneste === 'Annet') { %> selected<% } %>>Annet</option>
              </select>
            </div>

            <div class="felt">
              <label for="melding">Melding <span class="hint">(påkrevd)</span></label>
              <textarea id="melding" name="melding" required maxlength="4000"
                        <% if (harFeil('melding')) { %>aria-invalid="true"<% } %>
                        placeholder="Fortell kort om jobben – hva slags rom eller bygg, omtrentlig størrelse, og når du tenker det passer."><%= skjema.melding %></textarea>
            </div>

            <div class="felt felt--skjult" aria-hidden="true">
              <label for="nettside">La dette feltet stå tomt</label>
              <input type="text" id="nettside" name="nettside" tabindex="-1" autocomplete="off">
            </div>

            <div>
              <button class="knapp" type="submit">Send henvendelse</button>
            </div>
            <p class="hint t-dempa">
              Vi bruker opplysningene kun til å svare deg. Les mer i <a href="/personvern">personvernerklæringen</a>.
            </p>
          </form>
        </div>

        <aside class="info-kort avslor">
          <h2>Kontaktinformasjon</h2>
          <ul class="info-liste">
            <li>
              <span class="etikett">Telefon</span>
              <a href="<%= telefonLenke(c.bedrift.telefon) %>"><%= c.bedrift.telefon %></a>
            </li>
            <li>
              <span class="etikett">E-post</span>
              <a href="mailto:<%= c.bedrift.epost %>"><%= c.bedrift.epost %></a>
            </li>
            <li>
              <span class="etikett">Besøksadresse</span>
              <span><%= c.bedrift.adresse %><br><%= c.bedrift.postnr %> <%= c.bedrift.poststed %></span>
            </li>
            <li>
              <span class="etikett">Organisasjonsnummer</span>
              <span><%= c.bedrift.orgnr %></span>
            </li>
          </ul>

          <h2 class="mt-2">Åpningstider</h2>
          <ul class="info-liste">
            <% (Array.isArray(c.bedrift.apningstider) ? c.bedrift.apningstider : []).forEach(function (a) { %>
              <li><span class="etikett"><%= a.dag %></span><span><%= a.tid %></span></li>
            <% }); %>
          </ul>
          <% if (c.bedrift.apningstiderErPlassholder && c.bedrift.apningstiderNotat) { %>
            <p class="plassholder-merke"><%= c.bedrift.apningstiderNotat %></p>
          <% } %>
        </aside>
      </div>
    </div>
  </section>
</main>

<%- include('partials/footer') %>
</body>
</html>
